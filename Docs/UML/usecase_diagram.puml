@startuml
left to right direction
skinparam packageStyle rectangle

' Стилізація як на малюнку
skinparam rectangle {
    BackgroundColor white
    BorderColor black
}
skinparam package {
    BackgroundColor white
    BorderColor black
}

actor "Гравець (Human Player)" as Player
actor "Комп'ютерний опонент (AI)" as AI
actor "Система / TurnManager" as System

rectangle "Покрокова Стратегія (Game System)" {

    ' Лівий верхній пакет
    package "Глобальна Карта та Економіка" {
        usecase "UC-7: Пересувати героя по сітці" as UC7
        usecase "UC-8: Взаємодіяти з об'єктами" as UC8
        usecase "UC-9: Наймати війська" as UC9
        usecase "UC-10: Керувати армією" as UC10
        usecase "UC-20: Завершити хід" as UC20
        usecase "UC-21: Переглянути характеристики" as UC21
    }

    ' Правий верхній пакет
    package "Основний функціонал та Дані" {
        usecase "UC-1: Запустити нову гру" as UC1
        usecase "UC-2: Завантажити вхідні дані" as UC2
        usecase "UC-3: Зберегти результати гри" as UC3
        usecase "UC-4: Завантажити збереження" as UC4
        usecase "UC-5: Пошук об'єктів" as UC5
        usecase "UC-6: Сортування об'єктів\n(за швидкістю/типом)" as UC6
    }

    ' Лівий нижній пакет
    package "Тактичний Бій" {
        usecase "UC-16: Ініціалізувати бій" as UC16
        usecase "UC-17: Зробити хід юнітом" as UC17
        usecase "UC-18: Атакувати ворога" as UC18
        usecase "UC-19: Завершити бій" as UC19
    }

    ' Правий нижній пакет (блакитний)
    package "Модуль ШІ (Зона відповідальності ШІ)" #LightBlue {
        usecase "UC-11: Обчислити хід ШІ" as UC11
        usecase "UC-12: Проаналізувати стан карти" as UC12
        usecase "UC-13: Прийняти рішення про найм" as UC13
        usecase "UC-14: Обрати ціль та шлях ШІ" as UC14
        usecase "UC-15: Прийняти рішення в бою ШІ" as UC15
        usecase "UC-22: Оцінити співвідношення сил" as UC22
        usecase "UC-23: Відступити / Втекти" as UC23
        usecase "UC-24: Створити / знищити ШІ-юніт" as UC24
        usecase "UC-25: Налаштувати складність ШІ" as UC25
    }
}

' Приховане вирівнювання пакетів 2x2 дляPlantUML
"Глобальна Карта та Економіка" -[hidden]right-> "Основний функціонал та Дані"
"Глобальна Карта та Економіка" -[hidden]down-> "Тактичний Бій"
"Основний функціонал та Дані" -[hidden]down-> "Модуль ШІ (Зона відповідальності ШІ)"

' ==========================================
' ЗВ'ЯЗКИ АКТОРІВ (Згідно з вашим кодом)
' ==========================================

Player --> UC1
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC7
Player --> UC9
Player --> UC10
Player --> UC17
Player --> UC20
Player --> UC21
Player --> UC25

AI --> UC11
AI --> UC15

System --> UC2
System --> UC16
System --> UC24

' ==========================================
' ВНУТРІШНІ ЗВ'ЯЗКИ (Include / Extend)
' ==========================================

' Основний функціонал
UC1 .right.> UC2 : <<include>>
UC20 .down.> UC11 : <<include>> (передача ходу)

' Модуль ШІ
UC11 .right.> UC14 : <<include>>
UC11 .down.> UC12 : <<include>>
UC11 .up.> UC22 : <<include>>
UC15 .right.> UC14 : <<include>>
UC14 <.right. UC13 : <<extend>>
UC22 <.right. UC23 : <<extend>> (якщо ворог сильніший)

' Глобальна карта
UC7 <.right. UC8 : <<extend>>
UC7 <.down. UC16 : <<extend>> (при зіткненні)

' Бій
UC17 .right.> UC18 : <<include>>
UC18 <.right. UC19 : <<extend>> (якщо одна зі сторін знищена)

@enduml